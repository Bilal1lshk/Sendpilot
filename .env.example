# =====================================================================
# SendPilot Environment Variables & Secrets Configuration Template
# =====================================================================
# Copy this file to .env or .env.local and populate with your real secrets.
# NEVER commit your real .env file or credentials to source control.
# =====================================================================

# 1. Database Connection
# MongoDB Atlas connection string (ensure your IP is whitelisted in Network Access)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sendpilot?retryWrites=true&w=majority

# 2. NextAuth Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_32_character_random_auth_secret_key
NEXTAUTH_SECRET=your_32_character_random_auth_secret_key
AUTH_URL=https://sendpilot-gamma.vercel.app
NEXTAUTH_URL=https://sendpilot-gamma.vercel.app
AUTH_TRUST_HOST=true

# Server-only AES-256-GCM key for LinkedIn OAuth credentials. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_ENC_KEY=replace_with_a_base64_encoded_32_byte_key

# 3. Google OAuth (For Google Single Sign-On)
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# 4. LinkedIn OAuth Configuration
# Registered app from LinkedIn Developer Portal (https://www.linkedin.com/developers)
LINKEDIN_CLIENT_ID=your_linkedin_app_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_app_client_secret

# The exact Authorized Redirect URL registered in your LinkedIn Developer App:
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Developer Tools fallback redirect URL (optional for manual code testing):
LINKEDIN_DEV_REDIRECT_URI=https://www.linkedin.com/developers/tools/oauth/redirect

# LinkedIn OAuth requests only openid/profile/email; no write scope is requested.

# 5. SMTP Email Configuration (Plain SMTP with Nodemailer for OTP & Password Reset)
SMTP_HOST=mail.mbstack.net
SMTP_PORT=465
SMTP_USER=contact@mbstack.net
SMTP_PASS=your-mailbox-password
SMTP_FROM="MB Stack <contact@mbstack.net>"
OTP_SECRET=your_long_random_otp_secret_string

