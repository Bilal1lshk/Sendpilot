# Worker environment file for your VPS
# Copy to your VPS at: .env.worker

PORT=10000
NODE_ENV=production
HEADLESS=true
AUTO_TUNNEL=false
MAX_CONCURRENCY=1

# Change to a strong random key (e.g. `openssl rand -hex 32`)
LINKEDIN_WORKER_SECRET=your_worker_secret_here

# Your MongoDB Atlas Connection String
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/sendpilot?retryWrites=true&w=majority

# AES key matching your Next.js application
ENCRYPTION_KEY=your_encryption_key_here
